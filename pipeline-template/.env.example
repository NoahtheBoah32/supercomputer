# Copy to .env and fill in. .env is gitignored. Never commit it, never paste it in chat.
ELEVENLABS_API_KEY=
# PiAPI (api.piapi.ai): Seedance 2.5 video through tools/gen_video.py. Workspace > API Key.
PIAPI_API_KEY=
# The Image & Video workspace the video director drives in the browser.
ELEVENLABS_WORKSPACE_URL=https://elevenlabs.io/app/image-video
# Where the logged-in browser profile lives (gitignored). Relative to this folder.
BROWSER_PROFILE_DIR=browser-profile
